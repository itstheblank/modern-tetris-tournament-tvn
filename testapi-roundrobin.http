@baseUrl = http://localhost:3000/api

### Tạo giải đấu Round Robin
POST {{baseUrl}}/tournaments
Content-Type: application/json

{
    "name": "Vietnam Tetris Championship 2027",
    "game": "TETRIO",
    "type": "ROUND_ROBIN",
    "participants": [
        { "name": "Blank", "seed": 1 },
        { "name": "ShardNguyen", "seed": 2 },
        { "name": "Lightningreed", "seed": 3 },
        { "name": "Fire", "seed": 4 }
    ]
}

### Tạo bracket cho giải đấu Round Robin
POST {{baseUrl}}/tournaments/3/generate-bracket

### Xem bracket của giải đấu Round Robin
GET {{baseUrl}}/tournaments/3/bracket

### Cập nhật kết quả trận đấu có ID = 1
PUT {{baseUrl}}/matches/1/score
Content-Type: application/json

{
    "score1": 3,
    "score2": 0,
    "status": "COMPLETED"
}

### Cập nhật thông số trận đấu có ID = 1
POST {{baseUrl}}/matches/1/games
Content-Type: application/json

{
    "games": [
        {
            "stats": [
                { "playerId": 1, "apm": 110.5, "pps": 3.12, "vs": 250, "isWinner": true },
                { "playerId": 2, "apm": 95.0,  "pps": 1.70, "vs": 180, "isWinner": false }
            ]
        },
        {
            "stats": [
                { "playerId": 1, "apm": 125.0, "pps": 3.30, "vs": 270, "isWinner": true },
                { "playerId": 2, "apm": 100.2, "pps": 2.2, "vs": 195, "isWinner": false }
            ]
        },
        {
            "stats": [
                { "playerId": 1, "apm": 160.0, "pps": 3.15, "vs": 350, "isWinner": true },
                { "playerId": 2, "apm": 130.2, "pps": 2.45, "vs": 269, "isWinner": false }
            ]
        }
    ]
}

